# /etc/sudoers.d/noizu-local-dev
#
# Passwordless sudo for cluster-port-forward aliases + hosts install.
# Digests pin the binaries so a replaced ifconfig/tee/cp won't match.
#
# Install (as root, after visudo -c):
#   sudo cp share/sudoers.d-noizu-local-dev /etc/sudoers.d/noizu-local-dev
#   sudo chmod 440 /etc/sudoers.d/noizu-local-dev
#   sudo visudo -c
#
# Generated for macOS paths; re-run digests after OS update if sudo starts failing:
#   shasum -a 256 /sbin/ifconfig /usr/bin/tee /bin/cp
#
# User: set NOIZU_USER below (default keithbrings) or replace with %admin

Defaults!NOIZU_LOCAL_DEV !requiretty

